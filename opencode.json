{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright-extension": {
      "type": "local",
      "command": ["./node_modules/.bin/playwright-mcp", "--extension"],
      "cwd": "frontend",
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  }
}
