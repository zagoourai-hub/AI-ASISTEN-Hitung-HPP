# Copy this file to .env for local Docker Compose usage.
# Use URL-safe characters in POSTGRES_PASSWORD because it is part of the
# internal asyncpg connection URL.
POSTGRES_IMAGE=postgres:16-alpine
PYTHON_IMAGE=python:3.12-slim
POSTGRES_DB=hpp
POSTGRES_USER=hpp_user
POSTGRES_PASSWORD=replace-with-url-safe-local-password
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=ai-hitung-hpp-postgres-data
BACKEND_PORT=8000

HPP_ENVIRONMENT=development
HPP_SECRET_KEY=replace-with-at-least-32-random-characters
HPP_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
HPP_RATE_LIMIT_AI_REQUESTS=20

# Optional until AI Assistant is enabled. Never commit the real key.
HPP_OPENROUTER_API_KEY=
HPP_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
HPP_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HPP_OPENROUTER_HTTP_REFERER=http://localhost:3000
HPP_OPENROUTER_APP_TITLE=HPP Pintar
HPP_OPENROUTER_TIMEOUT_SECONDS=60
HPP_OPENROUTER_MAX_TOKENS=2000
