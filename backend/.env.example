# Runtime
HPP_ENVIRONMENT=development
HPP_APP_NAME=AI Hitung HPP API

# PostgreSQL; use a secret value only in a local .env file or deployment secret store.
HPP_DATABASE_URL=postgresql+asyncpg://hpp_user:change_me@localhost:5432/hpp
HPP_DATABASE_COMMAND_TIMEOUT_SECONDS=10
HPP_SECRET_KEY=replace-with-at-least-32-random-characters

# API and browser session
HPP_API_V1_PREFIX=/api/v1
HPP_SESSION_COOKIE_NAME=hpp_session
HPP_SESSION_COOKIE_SECURE=false
HPP_SESSION_COOKIE_HTTPONLY=true
HPP_SESSION_COOKIE_SAMESITE=lax
HPP_SESSION_COOKIE_MAX_AGE_SECONDS=604800
HPP_PASSWORD_RESET_TOKEN_MAX_AGE_SECONDS=3600
HPP_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
HPP_CORS_ALLOW_CREDENTIALS=true

# MVP money policy
HPP_CURRENCY=IDR

# Rate limiting; use Redis when deployment has multiple backend instances.
HPP_RATE_LIMIT_BACKEND=memory
HPP_RATE_LIMIT_WINDOW_SECONDS=60
HPP_RATE_LIMIT_REQUESTS=60
HPP_RATE_LIMIT_LOGIN_REQUESTS=5
